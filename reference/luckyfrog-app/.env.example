# ============================================================
# LUCKY FROG — Environment Variables
# Copy this file to .env.local and fill in your values.
#
# Login: Robinhood Chain only (EIP-6963 wallets, personal_sign).
# No chain switching — NEXT_PUBLIC_CHAIN is always "robinhood".
# ============================================================


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

# MongoDB connection string (required)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/luckyfrog?retryWrites=true&w=majority


# ------------------------------------------------------------
# Auth
# ------------------------------------------------------------

# Secret used to sign and verify JWT session tokens.
# Generate with: openssl rand -base64 32
JWT_SECRET=


# ------------------------------------------------------------
# Blockchain — Robinhood Chain (EVM, chain ID 4663)
# The game uses Robinhood Chain exclusively. No chain switching.
# ------------------------------------------------------------

# Active chain — always "robinhood". Do not change.
NEXT_PUBLIC_CHAIN=robinhood

# Robinhood Chain JSON-RPC endpoint.
# Default: https://rpc.mainnet.chain.robinhood.com/
# Override only if you run a private or backup RPC node.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com/

# Robinhood Chain ID (mainnet = 4663). Change only for testnet.
ROBINHOOD_CHAIN_ID=4663

# ERC-20 game token contract address on Robinhood Chain.
CONTRACT_ADDRESS=

# Display name of the game token shown in UI (default: $LFRG).
# ROBINHOOD_TOKEN_NAME is server-only; NEXT_PUBLIC_TOKEN_NAME is sent to the browser.
# Both default to "$LFRG" if not set.
ROBINHOOD_TOKEN_NAME=$LFRG
NEXT_PUBLIC_TOKEN_NAME=$LFRG

# Token decimals (default 18 — only change if the token uses a different value).
ROBINHOOD_TOKEN_DECIMALS=18

# Treasury wallet public address that receives deposit fees / pays out rewards.
# SAFE to expose to the browser — it is a receive-only address.
TREASURY_ADDRESS=

# Treasury private key — SERVER-ONLY. NEVER expose to the client or commit to git.
# Hex string with or without 0x prefix.
TREASURY_KEY=

# Browser-visible copies of the public addresses above.
# Required for the client-side deposit flow. Must match the server-side values.
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=

# Master switch for the withdrawal feature.
# Set to "true" to open withdrawals. Any other value (or absent) disables them.
NEXT_PUBLIC_WALLET_ENABLED=false


# ------------------------------------------------------------
# WebSocket engine  (server/index.ts — pnpm run server:start)
# Deploy separately on a VPS. Set these on the Next.js side
# (Vercel dashboard or .env.local).
# ------------------------------------------------------------

# Full URL of the running WebSocket engine (https, no trailing slash).
# The Phaser client converts it to wss:// automatically.
NEXT_PUBLIC_WS_URL=https://ws.yourdomain.com

# Allowed CORS origin — set on the VPS process, not on Vercel.
# CORS_ORIGIN=https://your-app.vercel.app
