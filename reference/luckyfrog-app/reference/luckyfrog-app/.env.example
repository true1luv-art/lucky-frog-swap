# ===================================
# Lucky Frog Mine - Environment Variables
# ===================================

# MongoDB Connection
# Example: mongodb+srv://username:password@cluster.mongodb.net/luckyfrog?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/luckyfrog

# JWT Authentication Secret
# Used to sign and verify authentication tokens. Generate a strong secret for production.
# Generate with: openssl rand -base64 32
# NOTE: Use a DIFFERENT secret per environment (staging vs production).
JWT_SECRET=your-jwt-secret-key-change-in-production

# ===================================
# Environment / Access Gate
# ===================================

# Which environment this deployment represents: "staging" | "production" | "development".
# Used only for cosmetic/operational concerns (banners, logging) — never for game logic.
# If unset, falls back to Vercel's automatic VERCEL_ENV (staging branch = "preview").
# Set NEXT_PUBLIC_APP_ENV too if you need to read it in the browser (e.g. a staging banner).
APP_ENV=development
# NEXT_PUBLIC_APP_ENV=development

# Minimum $LFRG a wallet must hold to access the game.
# Enforced server-side in login/register — cannot be bypassed client-side.
# Set per environment: staging = 1000000, production = 1000.
MIN_HOLD_LFRG=1000

# ===================================
# Solana Configuration
# ===================================

# Solana RPC Endpoint
# For production, use a paid RPC with websocket support (Helius, Alchemy, etc.)
# Mainnet: https://api.mainnet-beta.solana.com
# Devnet: https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com

# $LFRG Token Mint Address (SPL Token on Pump Fun)
# This is the token mint address from your Pump Fun deployment
# Find it in your Pump Fun token dashboard or Solana explorer
# Format: Base58 address (e.g., "44z1EhpgLxKwve5gre9qavqyrQDMddWQw7nAmkznqAi")
LFRG_MINT_ADDRESS=

# ===================================
# Treasury Wallet Configuration
# ===================================

# Market Address (Public Key)
# Receives 100% of egg/chest purchases. The daily settlement cron later splits it.
# IMPORTANT: On staging, set this to a SEPARATE staging wallet so test purchases
# (which you refund manually) never mix with the real production market wallet.
# Format: Solana public key (e.g., "7xL...")
MARKET_ADDRESS=

# LuckyFrog-Smart-Contract ESCROW Wallet (Public Key) + Private Key (Base58)
# The escrow wallet used by services/marketplace/app.ts. Buyers deposit the FULL
# price here for BOTH egg purchases and marketplace trades; the smart-contract
# runtime then pays the seller their 95% net (keeping the 5% fee) and refunds the
# buyer if settlement fails. For eggs it refunds the full amount after granting.
# MARKET_TEST_PRIVATE_KEY signs those outbound payouts server-side and MUST
# correspond to MARKET_TEST_ADDRESS.
# IMPORTANT: Keep the private key secret! Never commit to version control.
MARKET_TEST_ADDRESS=
MARKET_TEST_PRIVATE_KEY=

# Treasury Wallet Address (Public Key)
# This wallet receives 60% of chest purchase revenue
# On staging, point this at a staging treasury (or leave unset) so the settlement
# worker never sweeps test funds into the real production treasury.
# Format: Solana public key (e.g., "7xL...")
TREASURY_WALLET=

# Treasury Private Key (Base58 encoded)
# Used to sign transactions for token rewards from the Pump Fun pool
# IMPORTANT: Keep this secret! Never commit to version control.
# Format: Base58 encoded Solana keypair (typically 87-88 characters)
# Generate a new keypair: solana-keygen new -o treasury-keypair.json
# Then extract the secret key from the keypair file and convert to Base58 if needed
TREASURY_PRIVATE_KEY=

# ===================================
# Game Wallet Addresses
# ===================================

# Burn Address
# Wallet that receives 20% of chest purchase revenue (tokens are burned/removed from circulation)
# Format: PublicKey string
BURN_ADDRESS=

# Leaderboard Wallet
# Wallet that receives 20% of chest purchase revenue for leaderboard rewards
# Format: PublicKey string
LEADERBOARD_WALLET=

# ===================================
# Optional: Helius API (for Advanced Solana Features)
# ===================================

# Helius API Key (optional)
# Used for enhanced Solana RPC features and analytics
# Get one at: https://www.helius.dev/
HELIUS_API_KEY=

# ===================================
# Optional: MongoDB Debug Logging
# ===================================

# Uncomment these for troubleshooting MongoDB issues

# MONGODB_LOG_ALL=debug
# MONGODB_LOG_CLIENT=debug
# MONGODB_LOG_COMMAND=debug
# MONGODB_LOG_CONNECTION=debug
# MONGODB_LOG_SERVER_SELECTION=debug
# MONGODB_LOG_TOPOLOGY=debug
# MONGODB_LOG_PATH=/var/log/mongodb.log
# MONGODB_LOG_MAX_DOCUMENT_LENGTH=1000
# MONGODB_CRYPT_DEBUG=1
